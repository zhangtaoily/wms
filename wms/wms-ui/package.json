{
  "name": "wms",
  "version": "5.0.0",
  "description": "云梭智能仓储管理系统（WMS）",
  "author": "LionLi",
  "license": "MIT",
  "overrides": {
    "highlight.js": "$highlight.js"
  },
  "scripts": {
    "dev": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service serve",
    "dev:legacy": "vue-cli-service serve",
    "build:prod": "set NODE_OPTIONS=--openssl-legacy-provider && vue-cli-service build",
    "build:dev": "vue-cli-service build --mode development",
    "preview": "node build/index.js --preview",
    "lint": "eslint --ext .js,.vue src",
    "alova": "alova"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-ui",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
  "repository": {
    "type": "git",
    "url": "http://192.168.0.79:8060/wms/wms"
  },
  "dependencies": {
    "@alova/adapter-axios": "^2.0.16",
    "@alova/mock": "^2.0.17",
    "@alova/vue-options": "^2.0.13",
    "@riophae/vue-treeselect": "0.4.0",
    "alova": "^3.3.4",
    "async-validator": "^4.2.5",
    "axios": "0.24.0",
    "clipboard": "2.0.8",
    "core-js": "3.25.3",
    "echarts": "5.4.0",
    "el-table-draggable": "^1.4.12",
    "el-table-virtual-scroll": "^2.0.2",
    "element-ui": "2.15.13",
    "file-saver": "2.0.5",
    "fuse.js": "6.4.3",
    "highlight.js": "^11.9.0",
    "js-beautify": "1.13.0",
    "js-cookie": "3.0.1",
    "jsencrypt": "3.0.0-rc.1",
    "lodash": "^4.17.21",
    "nprogress": "0.2.0",
    "qs": "^6.13.0",
    "quill": "1.3.7",
    "screenfull": "5.0.2",
    "sortablejs": "1.10.2",
    "vue": "2.6.12",
    "vue-count-to": "1.0.13",
    "vue-cropper": "0.5.5",
    "vue-json-viewer": "^2.2.22",
    "vue-meta": "2.4.0",
    "vue-router": "3.4.9",
    "vuedraggable": "2.24.3",
    "vuex": "3.6.0"
  },
  "devDependencies": {
    "@alova/wormhole": "^1.4.4",
    "@vue/cli-plugin-babel": "4.4.6",
