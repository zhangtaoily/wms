# 页面标题
VUE_APP_TITLE = 云梭智能仓储管理系统（WMS）

# 开发环境配置
ENV = 'development'

# 若依管理系统/开发环境
VUE_APP_BASE_API = '/dev-api'
# 图片路径
VUE_APP_BASE_IMG = 'http://192.168.0.75:8050/img/'
# 应用访问路径 例如使用前缀 /admin/
VUE_APP_CONTEXT_PATH = '/'

# 监控地址
VUE_APP_MONITRO_ADMIN = 'http://localhost:9090/admin/applications'

# xxl-job 控制台地址
VUE_APP_XXL_JOB_ADMIN = 'http://192.168.0.75:9100/xxl-job-admin/'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 帆软报表nginx代理地址
VUE_APP_FR_PROXY = '/webroot/decision/v10/entry/access/'
